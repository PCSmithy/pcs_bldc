# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Bench captures backing the trace-analysis notebooks stay tracked
!tools/trace_analysis/**/*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local project settings
*.kicad_prl

# Python virtual environment
.venv/

# CMake build trees (top-level only — anchored so we don't accidentally
# ignore source dirs named "build", e.g. sw/lib/c/shared/lib/build/).
/build/

# KiCad .history (incremental in-app backups; git is the version history)
.history/

# Generated analysis outputs (regenerable via kicad-happy scripts)
**/drc*.json
**/erc*.json
**/*_analysis*.json
**/gerber_analysis*.json

# Obsidian per-user vault state (workspace layout, last-open files, etc.)
.obsidian/

# VSCode workspace config — machine-specific debug paths (CubeIDE plugin
# locations, ST-Link/OpenOCD/GDB absolute paths). Kept local per-machine.
.vscode/

# Python bytecode cache
__pycache__/
*.pyc

# Rust build output — each workspace/standalone crate owns a target dir
# (sw/sil/.gitignore covers the SIL workspace's)
sw/lib/rust/*/target/
sw/gui/src-tauri/target/

# Tauri build-time generated context
sw/gui/src-tauri/gen/

# nanopb-generated protocol bindings (regenerated from sw/proto/ at build
# time; the build requires the project venv — see sw/fw/src/lib/protobuf/)
*.pb.h
*.pb.c

# Generated build identity (refreshed every build from git state — see
# sw/fw/src/lib/build/generate_identity.cmake)
lib_build_identity.h

# Python protobuf bindings for the console client (generated on demand)
tools/pcs_client_gen/

# Claude Code runtime artifacts (committed config like skills/ stays tracked)
.claude/scheduled_tasks.lock

# Ephemeral session-handoff scratch notes (see the file header — intentionally
# untracked; refreshed each session).
docs/handoff.md

# Cygwin/MSYS crash dumps (e.g. left by the CubeMX conversion script)
*.stackdump
