# Script mode (cmake -P): write generated/lib_build_identity.h defining
# LIB_BUILD_IDENTITY — the 12-hex-digit commit hash of the built source,
# extended with "+" and the first 8 hex digits of the SHA-1 of the
# uncommitted diff when the tree is dirty. The header is only rewritten
# when the identity changes, so dependents rebuild only then.
#
# Inputs: -DREPO_ROOT=<repo> -DOUT=<header path>

execute_process(
  COMMAND git rev-parse --short=12 HEAD
  WORKING_DIRECTORY ${REPO_ROOT}
  OUTPUT_VARIABLE PCS_SHA
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PCS_SHA_RC
)
if(NOT PCS_SHA_RC EQUAL 0)
  message(FATAL_ERROR "build identity: 'git rev-parse' failed - the firmware "
                      "build derives its identity from git (${REPO_ROOT}).")
endif()

execute_process(
  COMMAND git diff HEAD
  WORKING_DIRECTORY ${REPO_ROOT}
  OUTPUT_VARIABLE PCS_DIFF
  RESULT_VARIABLE PCS_DIFF_RC
)
if(NOT PCS_DIFF_RC EQUAL 0)
  message(FATAL_ERROR "build identity: 'git diff' failed in ${REPO_ROOT}.")
endif()

set(PCS_IDENTITY "${PCS_SHA}")
if(NOT PCS_DIFF STREQUAL "")
  string(SHA1 PCS_DIFF_HASH "${PCS_DIFF}")
  string(SUBSTRING ${PCS_DIFF_HASH} 0 8 PCS_DIFF8)
  set(PCS_IDENTITY "${PCS_SHA}+${PCS_DIFF8}")
endif()

file(WRITE ${OUT}.tmp
  "#pragma once\n"
  "\n"
  "// Generated by generate_identity.cmake - do not edit.\n"
  "#define LIB_BUILD_IDENTITY  \"${PCS_IDENTITY}\"\n"
)
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
