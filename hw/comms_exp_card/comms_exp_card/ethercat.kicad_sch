	(text "Port 1 (OUT) = PHY B"
		(exclude_from_sim no)
		(at 284.48 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fdd4d30f-0d69-5a33-b9d8-513413037d6b")
	)
	(text_box "LAN9252 configuration\nHost: SPI / SQI on SCK, SCS, SIO[3:0] (PDI type 0x80 comes from the SII EEPROM).\nCHIP_MODE[1:0] = 00 (1k pull-downs on LINKACTLED0/1): 2-port mode,\n  port 0 = PHY A = IN, port 1 = PHY B = OUT. Those two LED outputs are then active high.\nE2PSIZE = 1 (5.1k pull-up on RUNLED): 32 Kbit and larger EEPROM, 2 address bytes. RUN LED active low.\nCopper on both ports: FXLOSEN, FXSDENA, FXSDENB low.\nREG_EN high: internal 1.2 V core + oscillator regulators on (VDDCR is an output; OSCVDD12 open).\nGPIO pins are unused and stay hi-Z until the EEPROM loads: configure them as outputs in the SII.\nRST: open-drain, internal pull-up; the chip also drives it low during its own reset."
		(exclude_from_sim no)
		(at 127 209.55 0)
		(size 127 22.86)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.254)
			(type solid)
			(color 72 72 0 1)
		)
		(fill
			(type color)
			(color 194 194 0 0.5)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "364ae4de-1e3d-5958-b8bf-74e2e3b705db")
	)
	(text_box "Crystal: EtherCAT allows +-25 ppm in total (tolerance + temperature + ageing); 802.3 allows +-50 ppm.\nCL 10 pF = 2 x 10 pF in series + about 5 pF of pin and track.\n470R in OSCO: the oscillator needs a 300 uW crystal unless about 500R is in series (then 100 uW);\nthis crystal is rated 200 uW max."
		(exclude_from_sim no)
		(at 127 236.22 0)
		(size 127 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0.254)
			(type solid)
			(color 72 72 0 1)
		)
		(fill
			(type color)
			(color 194 194 0 0.5)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f5a1508e-7c6d-59ff-91ee-305a07bcdbc6")
	)
