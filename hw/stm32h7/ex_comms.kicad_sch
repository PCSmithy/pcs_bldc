	)
	(text "mini PCIe socket with a CUSTOM pinout - not a standard card slot.\nEXP_5V0 (switched, ~1A) on the 3.3Vaux pins 2/24/39/41/52.\nPin 6 = 3V3_ID through 220R: powers the card ID EEPROM only, so the\ncard can be identified over I2C before EXP_5V0 is enabled.\nQSPI on the PCIe lane pins (grounds either side); 33R series = edge\ndamping + fault current limit. Expansion cards are 1.0 mm PCB."
		(exclude_from_sim no)
		(at 158.75 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a65428db-2665-4f93-8083-949fb63da928")
	)
